---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import Icon from '../../components/Icon.astro';
import { getHomeProjects, projectToTileData } from '../../lib/projects';
import { t } from '../../lib/i18n';

const locale = 'de' as const;
const params = Astro.url.searchParams;
const greeting = params.get('greeting');
const allProjects = await getHomeProjects(locale);
const textRotateItems = t('text_rotate', locale).split('", "').map((s) => s.replace(/^"|"$/g, ''));
const title = 'Robert Michels | Designer- & Entwickler-Portfolio';
const description =
  'Robert Michels — Designer und Entwickler aus Vancouver. Spiele, Websites und Apps: Portfolio und Fallstudien auf Deutsch.';
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  pageType="home"
  canonicalPath="/de/"
>
  <div class="downArrowWrapper">
    <div class="downArrow" id="downArrow">
      <a href="#MyWork" title={t('view_projects', locale)} aria-label={t('view_projects', locale)}>
        <Icon name="chevron-down" class="icon-chevron-down" />
      </a>
    </div>
  </div>
  <div id="threeModel" style="visibility: hidden; display: none;" aria-hidden="true"></div>
  <div class="landingModelImageWrapper">
    <ResponsiveImage
      src="/assets/img/landingModel.webp"
      layout="landingModel"
      alt=""
      fetchpriority="high"
      loading="eager"
      imgAttrs={{ id: 'landingModelImage', 'aria-hidden': 'true' }}
    />
    <div id="spinner" class="landingSpinner" style="display: none;">
      <div class="fancySpinner"></div>
    </div>
  </div>
  <div id="landingArea">
    <div class="row">
      <div class="col-50" id="landingText">
        <h1 class="visually-hidden">
          {greeting
            ? `${t('hi_greeting', locale)}${greeting}${t('greeting_suffix', locale)}`
            : `${t('hi_im_robert', locale)} — Portfolio`}
        </h1>
        <p>
          {greeting ? (
            <>
              {t('hi_greeting', locale)}{greeting},
              <br />
              {t('greeting_suffix', locale).replace(/^, /, '')}
            </>
          ) : (
            <span set:html={t('hi_im_robert', locale).replace('Robert Michels', 'Robert&nbsp;Michels')} />
          )}
          <br />{t('i_design', locale)}<br />
          <span class="txt-rotate" data-period="2000" data-rotate={JSON.stringify(textRotateItems)}>
            {t('digital_media', locale)}
          </span>
        </p>
      </div>
    </div>
  </div>
  <section class="sectionMedia" id="MyWork">
    {allProjects.map((project) => {
      const tile = projectToTileData(project, locale);
      return (
        <ProjectTile
          slug={tile.slug}
          name={tile.name}
          type={tile.type}
          inDevelopment={tile.inDevelopment}
          roles={tile.roles}
          locale={locale}
        />
      );
    })}
    <div class="seeMoreBtn">
      <a href="/de/projects" aria-label={t('all_projects', locale)}>
        <span>{t('all_projects', locale)}</span>
        <div class="liquid"></div>
      </a>
    </div>
  </section>
  <script>
    import '../../islands/HomeFilter.ts';
  </script>
</BaseLayout>
