---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import { stacksInUse } from '../../lib/stack';
import { getAllProjects, projectToTileData } from '../../lib/projects';
import { t } from '../../lib/i18n';

const locale = 'de' as const;
const projects = await getAllProjects(locale);
const filterStacks = stacksInUse(projects.flatMap((project) => project.data.stack));
---

<BaseLayout
  title="Alle Projekte | Robert Michels Portfolio"
  description="Alle Projekte von Robert Michels: Games, XR, Web und Apps. Nach Technologie filtern und Fallstudien auf rmichels.com entdecken."
  locale={locale}
  pageType="projects"
  canonicalPath="/de/projects"
>
  <section id="Projects">
    <div class="projectsFilter">
      <div>
        <h1>{t('filter_projects', locale)} (<span id="projectCount">{projects.length}</span>)</h1>
      </div>
      {filterStacks.map((entry) => (
        <button class="filterBtn" data-js={entry.slug}>{entry.label}</button>
      ))}
    </div>
    <div id="projectTileHidden"></div>
    <div id="projectTileVisible">
      {projects.map((project) => {
        const tile = projectToTileData(project, locale);
        return (
          <ProjectTile slug={tile.slug} name={tile.name} type={tile.type} inDevelopment={tile.inDevelopment} stack={tile.stack} locale={locale} />
        );
      })}
    </div>
  </section>
</BaseLayout>
<script>
  import '../../islands/ProjectFilter.ts';
</script>
