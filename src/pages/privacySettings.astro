---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrivacySettingsContent from '../components/PrivacySettingsContent.astro';

const locale = 'en' as const;
---

<BaseLayout
  title="Privacy Settings | Robert Michels Portfolio"
  description="Manage analytics opt-out and third-party embed preferences for rmichels.com in your browser."
  locale={locale}
  pageType="privacy"
  canonicalPath="/privacySettings"
>
  <PrivacySettingsContent locale={locale} />
</BaseLayout>
