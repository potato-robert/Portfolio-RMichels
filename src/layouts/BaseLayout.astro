---
import '../styles/main.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import { UMAMI_SCRIPT_URL, UMAMI_WEBSITE_ID } from '../lib/analytics';
import type { CreativeWorkInput } from '../lib/structured-data';
import {
  type Locale,
  getLocaleFromUrl,
  getAlternateUrl,
  alternateLocale,
  t,
} from '../lib/i18n';

export interface Props {
  title: string;
  description: string;
  locale?: Locale;
  pageType?: 'home' | 'about' | 'projects' | 'project' | 'privacy' | 'default';
  ogImage?: string;
  canonicalPath?: string;
  creativeWork?: CreativeWorkInput;
}

const {
  title,
  description,
  locale: localeProp,
  pageType = 'default',
  ogImage = 'https://rmichels.com/assets/img/portfolio.jpg',
  canonicalPath,
  creativeWork,
} = Astro.props;

const locale = localeProp ?? getLocaleFromUrl(Astro.url);
const altLocale = alternateLocale(locale);
const site = Astro.site?.href?.replace(/\/$/, '') ?? 'https://rmichels.com';
const path = canonicalPath ?? Astro.url.pathname;
const canonical = `${site}${path === '/' ? '' : path}`;
const altPath = getAlternateUrl(path, altLocale);
const altUrl = `${site}${altPath === '/' ? '' : altPath}`;
const enUrl = locale === 'en' ? canonical : `${site}${getAlternateUrl(path, 'en')}`;
const deUrl = locale === 'de' ? canonical : `${site}${getAlternateUrl(path, 'de')}`;
const htmlLang = locale === 'de' ? 'de' : 'en';
const ogLocale = locale === 'de' ? 'de_DE' : 'en_US';
const ogLocaleAlternate = locale === 'de' ? 'en_US' : 'de_DE';
const ogType = pageType === 'project' ? 'article' : 'website';
const showHomeIcon = pageType === 'project' || pageType === 'about';
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <script
      is:inline
      define:vars={{ umamiScriptUrl: UMAMI_SCRIPT_URL, umamiWebsiteId: UMAMI_WEBSITE_ID }}
    >
      (function () {
        try {
          if (localStorage.getItem('rmAnalyticsOptOut') === '1') return;
        } catch (e) {
          return;
        }
        if (navigator.globalPrivacyControl === true) return;
        var dnt = navigator.doNotTrack || window.doNotTrack;
        if (dnt === '1' || dnt === 'yes') return;
        var s = document.createElement('script');
        s.defer = true;
        s.src = umamiScriptUrl;
        s.dataset.websiteId = umamiWebsiteId;
        s.dataset.domains = 'rmichels.com';
        document.head.appendChild(s);
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonical} />
    <StructuredData
      pageType={pageType}
      siteUrl={site}
      pageUrl={canonical}
      locale={locale}
      creativeWork={creativeWork}
    />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="stylesheet" href="/css/normalize.css" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icon/favicon-16x16.png" />
    <link rel="manifest" href="/assets/icon/site.webmanifest" />
    <link rel="mask-icon" href="/assets/icon/safari-pinned-tab.svg" color="#5bbad5" />
    <link rel="shortcut icon" href="/assets/icon/favicon.ico" />
    <meta name="msapplication-TileColor" content="#da532c" />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body data-page-type={pageType}>
    <a class="skip-link" href="#Content">{t('skip_to_content', locale)}</a>
    <script>
      import { syncPerfTierToDocument } from '../lib/device-capability';
      syncPerfTierToDocument();
      document.addEventListener('DOMContentLoaded', syncPerfTierToDocument);
    </script>
    <div>
      <div id="MainGrid">
        <Header locale={locale} pageType={pageType} altHref={altPath} />
        <main id="Content">
          <script>
            import '../islands/Menu.ts';
          </script>
          {
            (pageType === 'home' ||
              pageType === 'about' ||
              pageType === 'projects' ||
              pageType === 'project') && (
              <script>
                import '../islands/LenisSetup.ts';
              </script>
            )
          }
          <slot />
        </main>
        <Footer locale={locale} pageType={pageType} />
      </div>
    </div>
    <script>
      import '../islands/DownArrow.ts';
    </script>
    <script>
      import '../islands/PageBootCore.ts';
    </script>
  </body>
</html>
