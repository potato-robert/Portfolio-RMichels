---
import { getPrivacySettingsPath } from '../lib/legal';
import { t, type Locale } from '../lib/i18n';
import Icon from './Icon.astro';
import Checkbox from './Checkbox.astro';

interface Props {
  locale: Locale;
  pageType?: 'home' | 'about' | 'projects' | 'project' | 'privacy' | 'default';
}

const { locale, pageType = 'default' } = Astro.props;
const showContact = pageType !== 'about';

const privacyHref = locale === 'de' ? '/de/privacyPolicy' : '/privacyPolicy';
const privacySettingsHref = getPrivacySettingsPath(locale);
const legalNoticeHref = locale === 'de' ? '/de/legalNotice' : '/legalNotice';
const portfolioHref = locale === 'de' ? '/de/portfolio' : '/portfolio';
const year = new Date().getFullYear();
---

<footer id="Contact">
  {showContact && (
    <div>
      <ul class="icons">
        <li class="emailContainer">
          <a
            href="mailto: hi@rmichels.com"
            target="_blank"
            rel="noopener noreferrer"
            title="E-Mail | Right-click to copy to clipboard"
            aria-label={t('email_contact', locale)}
            id="emailLink"
          >
            <Icon name="envelope" size="2x" id="email" />
          </a>
        </li>
        <li class="emailAddress">
          <small class="js-emaillink">hi@rmichels.com</small>
        </li>
        <li>
          <a
            href="https://linkedin.com/in/robert-michels"
            target="_blank"
            rel="noopener noreferrer"
            title="LinkedIn"
            aria-label={t('social_linkedin', locale)}
          >
            <Icon name="linkedin-in" size="2x" />
          </a>
        </li>
        <li>
          <a
            href="https://github.com/potato-robert"
            target="_blank"
            rel="noopener noreferrer"
            title="GitHub"
            aria-label={t('social_github', locale)}
          >
            <Icon name="github" size="2x" />
          </a>
        </li>
        <li>
          <a
            href="https://play.google.com/store/apps/developer?id=Studio+RM"
            target="_blank"
            rel="noopener noreferrer"
            title="Google Play"
            aria-label={t('social_google_play', locale)}
          >
            <Icon name="google-play" size="2x" />
          </a>
        </li>
        <li>
          <a
            href="https://rmichels.itch.io/"
            target="_blank"
            rel="noopener noreferrer"
            title={t('social_itch_io', locale)}
            aria-label={t('social_itch_io', locale)}
          >
            <Icon name="itch-io" size="2x" />
          </a>
        </li>
      </ul>
    </div>
  )}
  {showContact && <noscript><small>hi@rmichels.com</small></noscript>}
    <div class="footerEnd">
      <small>
        {t('portfolio_developed', locale)}
        <a href={portfolioHref}>{t('developed', locale)}</a>
        {t('with_astro', locale)}
      </small>
      <small>{t('copyright', locale)} &copy; {year} {t('rights_reserved', locale)}</small>
      <Checkbox id="lenisScrollToggle" checked variant="auto">
        <small>{t('enable_smooth_scrolling', locale)}</small>
      </Checkbox>
      <div class="footerLegal">
        <a href={privacyHref}><small>{t('privacy_policy', locale)}</small></a>
        <a href={privacySettingsHref}><small>{t('privacy_settings', locale)}</small></a>
        <a href={legalNoticeHref}><small>{t('legal_notice', locale)}</small></a>
      </div>
    </div>
</footer>
<div class="footerBuffer"></div>

<div id="copyConfirm" class="hidden"><small>{t('copied', locale)}</small></div>

<script>
  import '../islands/EmailCopy.ts';
</script>
