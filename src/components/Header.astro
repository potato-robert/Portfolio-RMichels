---
import { t, type Locale } from '../lib/i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  pageType: 'home' | 'about' | 'projects' | 'project' | 'privacy' | 'default';
  altHref: string;
}

const { locale, pageType, altHref } = Astro.props;
const prefix = locale === 'de' ? '/de' : '';
const homeHref = prefix || '/';
const aboutHref = `${prefix}/about`;
const projectsHref = `${prefix}/projects`;
const altLabel = locale === 'en' ? t('deutsch', locale) : t('english', locale);
---

<header>
  <nav aria-label={t('site_nav', locale)}>
    <ul>
      {pageType === 'project' || pageType === 'about' ? (
        <li class="homeIcon">
          <a title={t('nav_home', locale)} href={homeHref} data-home-link aria-label={t('nav_home', locale)}>
            <Icon name="house" class="icon-header" />
          </a>
        </li>
      ) : (
        <li class="homeIcon">
          <a title={t('nav_about', locale)} href={aboutHref} aria-label={t('nav_about', locale)}>
            <Icon name="circle-info" class="icon-header" />
          </a>
        </li>
      )}
      <li>
        <button
          type="button"
          class="menuCont"
          id="MenuToggle"
          title={t('menu', locale)}
          aria-label={t('menu', locale)}
          aria-expanded="false"
          aria-controls="OverlayMenu"
        >
          <div class="bar1"></div>
          <div class="bar2"></div>
          <div class="bar3"></div>
        </button>
      </li>
    </ul>
  </nav>
  <div id="OverlayMenu" class="hidden" role="navigation" aria-label={t('menu', locale)} aria-hidden="true">
    <ul id="MenuContent">
      <li class:list={{ curPage: pageType === 'home' }}>
        <a title={t('featured_work', locale)} href={homeHref} data-home-link>
          {t('featured_work', locale)}
        </a>
      </li>
      <li class:list={{ curPage: pageType === 'about' }}>
        <a href={aboutHref} title={t('nav_about', locale)}>
          {t('about', locale)}
        </a>
      </li>
      <li class:list={{ curPage: pageType === 'projects' }}>
        <a href={projectsHref} title={t('all_projects', locale)}>
          {t('all_projects', locale)}
        </a>
      </li>
      <li class="overlayMenuSpacer" aria-hidden="true"></li>
      <li class="overlayMenuLanguageSelector">
        <a href={altHref} class="lang-toggle">{altLabel}</a>
      </li>
    </ul>
  </div>
</header>

<script>
  import { readVisitorFilterSession } from '../lib/visitor-filter';

  function applyVisitorFilterToHomeLinks() {
    const filter = readVisitorFilterSession();
    document.querySelectorAll('[data-home-link]').forEach((el) => {
      const base = el.getAttribute('href') || '/';
      el.setAttribute('href', filter ? `${base}?filter=${filter}` : base);
    });
  }
  applyVisitorFilterToHomeLinks();
</script>

<style>
  .lang-toggle {
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    font: inherit;
    padding: 0;
    text-decoration: none;
  }
</style>
