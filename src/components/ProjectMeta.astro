---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/i18n';
import { getFormatLabel } from '../lib/formats';
import { getStackLabel } from '../lib/stack';
import { formatProjectYear } from '../lib/projects';

interface Props {
  project: CollectionEntry<'projects'> | CollectionEntry<'projects-de'>;
  locale: Locale;
}

const { project, locale } = Astro.props;
const p = project.data;
const SIAT_URL = 'https://www.sfu.ca/siat.html';
const formatLabel = getFormatLabel(p.format, locale);
const yearLabel = formatProjectYear(p.year, p.ongoing, t('year_present', locale));
const contextLabel =
  p.context === 'coursework'
    ? t('context_coursework', locale)
    : p.context === 'personal'
      ? t('context_personal', locale)
      : (p.organization ?? '');
const contextHref = p.context === 'coursework' ? SIAT_URL : p.organizationUrl;
---

<div id="projMeta">
  <div class="projMetaItem">
    <h2>{t('format', locale)}</h2>
    <p>{formatLabel}</p>
  </div>
  <div class="projMetaItem">
    <h2>{t('year', locale)}</h2>
    <p>{yearLabel}</p>
  </div>
  <div class="projMetaItem stack">
    <h2>{t('stack', locale)}</h2>
    <ul>
      {p.stack.map((item) => <li>{getStackLabel(item)}</li>)}
    </ul>
  </div>
  <div class="projMetaItem context">
    <h2>{t('context', locale)}</h2>
    {contextHref ? (
      <a href={contextHref} target="_blank" rel="noopener noreferrer">{contextLabel}</a>
    ) : (
      <p>{contextLabel}</p>
    )}
  </div>
</div>
