---
import type { Locale } from '../lib/i18n';
import PrivacyPolicyDe from './legal/PrivacyPolicyDe.astro';
import PrivacyPolicyEn from './legal/PrivacyPolicyEn.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

{locale === 'de' ? <PrivacyPolicyDe /> : <PrivacyPolicyEn />}
