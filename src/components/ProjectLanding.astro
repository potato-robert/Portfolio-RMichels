---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';
import { getImageEntry } from '../lib/rm-assets';
import { getLocalized, getProjectSlug } from '../lib/projects';
import { t } from '../lib/i18n';
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  project: CollectionEntry<'projects'> | CollectionEntry<'projects-de'>;
  locale: Locale;
}

const { project, locale } = Astro.props;
const p = project.data;
const slug = getProjectSlug(project);
const links = p.links ?? [];
const heroSrc = `/assets/img/${slug}.jpg`;
const heroName = getLocalized(p.name, locale);
const heroEntry = getImageEntry(heroSrc);
---

<div class="projectDownArrowWrapper">
  <div class="downArrow downArrow-project" id="downArrow">
    <a href="#projMeta" aria-label={t('scroll_to_project_info', locale)}>
      <Icon name="chevron-down" class="icon-chevron-down" />
    </a>
  </div>
</div>
<div id="projLanding">
  <div class="row">
    <div class="col-50">
      <div class="landingText">
        <h1>{heroName}</h1>
        <p>{getLocalized(p.description, locale)}</p>
        <br />
        <div class="projectCallToAction">
          {links.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
          ))}
        </div>
      </div>
    </div>
    <div class="col-50">
      {heroEntry && (
        <ResponsiveImage
          src={heroSrc}
          alt=""
          layout="hero"
          class:list={['imgBG', p.heroAltLayout && 'alt']}
          loading="eager"
          imgAttrs={{ 'aria-hidden': 'true' }}
        />
      )}
      <ResponsiveImage
        src={heroSrc}
        alt={heroName}
        layout="hero"
        class="heroImg"
        fetchpriority="high"
        loading="eager"
      />
    </div>
  </div>
</div>
