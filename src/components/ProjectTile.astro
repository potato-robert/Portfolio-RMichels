---
import type { Locale } from '../lib/i18n';
import { t } from '../lib/i18n';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  slug: string;
  name: string;
  type: string;
  inDevelopment?: boolean;
  roles?: string[];
  locale: Locale;
  href?: string;
}

const { slug, name, type, inDevelopment = false, roles = [], locale, href } = Astro.props;
const prefix = locale === 'de' ? '/de' : '';
const finalHref = href ?? `${prefix}${inDevelopment ? `/development/${slug}` : `/${slug}`}`;
const roleString = roles.join(',');
const tileSrc = `/assets/img/${slug}.jpg`;
---

<article class="projRow projRow--visible" data-js={roleString || undefined}>
  <div class:list={['projPanel', inDevelopment && 'inDevelopment']}>
    <a href={finalHref} title={name} aria-label={`${name} — ${type}`}>
      <ResponsiveImage
        src={tileSrc}
        alt={name}
        layout="tile"
        class:list={inDevelopment ? ['inDevelopment'] : undefined}
      />
      {inDevelopment && <div class="inDevelopmentText">{t('in_development', locale)}</div>}
      <div class="projJScontainer">
        <h2 class="projLabel">{name}</h2>
        <p class="projMeta projTypeLabel">{type}</p>
      </div>
    </a>
  </div>
</article>
