    "lenis": "^1.1.14",
    "photoswipe": "^5.4.4",
    "three": "^0.175.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "happy-dom": "^20.11.1",
    "js-yaml": "^5.4.2",
    "sass": "^1.77.0",
    "vitest": "^3.0.0",
    "zod": "^4.6.5"
  }
